# Public frontend variables (safe to expose in the browser)
VITE_API_BASE_URL=

# Server-side only. Never expose in the frontend bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Product data provider (Etapa 02A) — server-side only, nunca com prefixo VITE_
APIFY_API_TOKEN=
APIFY_PRODUCT_ACTOR_ID=
APIFY_TIMEOUT_MS=120000

# Persistência (Etapa 02B.1) — server-side only
DATABASE_URL=
DATABASE_SSL=false

# TikTok Shop Open API (Etapa TikTok Oficial 01) — server-side only
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_REDIRECT_URI=https://tikradar.sinergia.club/api/auth/tiktok/callback
# Chave de criptografia dos tokens em repouso (base64 32 bytes ou string forte)
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Opcionais (defaults oficiais)
TIKTOK_SHOP_API_BASE_URL=
TIKTOK_SHOP_AUTH_BASE_URL=
TIKTOK_SHOP_TIMEOUT_MS=30000

# Seleção do provider de discovery: apify (padrão) | tiktok_official
DISCOVERY_PROVIDER=apify
